# Runtime
NODE_ENV=development
APP_DB_PATH=./data/assistant.db
HEALTH_HOST=0.0.0.0
HEALTH_PORT=8787
APP_TIMEZONE=America/Lima

# WhatsApp pairing / self-chat
WHATSAPP_PHONE_NUMBER=
WHATSAPP_SELF_JIDS=
WHATSAPP_ENABLED=false
LOG_MESSAGE_CONTENT=false

# Stage 2A — optional AI. Disabled by default.
AI_ENABLED=false
AI_PROVIDER=openai-compatible
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT_MS=20000
AI_MAX_INPUT_CHARS=4000
AI_MAX_REPLY_CHARS=3500
AI_MAX_OUTPUT_TOKENS=800

# Stage 2B — optional audio transcription. Disabled by default.
TRANSCRIPTION_ENABLED=false
TRANSCRIPTION_PROVIDER=openai-compatible
TRANSCRIPTION_BASE_URL=
TRANSCRIPTION_API_KEY=
TRANSCRIPTION_MODEL=
TRANSCRIPTION_TIMEOUT_MS=60000
TRANSCRIPTION_MAX_BYTES=15728640
TRANSCRIPTION_MAX_CHARS=6000

# Google Calendar writes. Disabled by default.
# Requires approval + explicit `ejecuta acción #N`.
CALENDAR_ENABLED=false
CALENDAR_PROVIDER=google
GOOGLE_CALENDAR_ID=primary
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REFRESH_TOKEN=
CALENDAR_TIMEOUT_MS=20000

# Optional daily local briefing. Disabled by default.
# Destination must also appear exactly in WHATSAPP_SELF_JIDS.
BRIEFING_ENABLED=false
BRIEFING_TIME=08:00
BRIEFING_DESTINATION_JID=
