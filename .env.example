# Runtime
NODE_ENV=development
APP_DB_PATH=./data/assistant.db
HEALTH_HOST=0.0.0.0
HEALTH_PORT=8787
APP_TIMEZONE=America/Lima

# Docker/Linux bind-mount identity. Required by docker-compose.yml so the
# non-root container process matches the numeric owner of ./data.
# Set these to `id -u` and `id -g` of the non-root deployment account.
# Never use 0:0 and do not make ./data world-writable (0777).
ASSISTANT_UID=
ASSISTANT_GID=

# WhatsApp pairing / self-chat
WHATSAPP_PHONE_NUMBER=
WHATSAPP_SELF_JIDS=
WHATSAPP_ENABLED=false
LOG_MESSAGE_CONTENT=false

# Stage 2A — optional AI. Disabled by default.
AI_ENABLED=false
AI_PROVIDER=openai-compatible
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT_MS=20000
AI_MAX_INPUT_CHARS=4000
AI_MAX_REPLY_CHARS=3500
AI_MAX_OUTPUT_TOKENS=800

# Stage 2B — optional audio transcription. Disabled by default.
TRANSCRIPTION_ENABLED=false
TRANSCRIPTION_PROVIDER=openai-compatible
TRANSCRIPTION_BASE_URL=
TRANSCRIPTION_API_KEY=
TRANSCRIPTION_MODEL=
TRANSCRIPTION_TIMEOUT_MS=60000
TRANSCRIPTION_MAX_BYTES=15728640
TRANSCRIPTION_MAX_CHARS=6000

# Stage 4A — local PDF text extraction/indexing. Disabled by default.
DOCUMENTS_ENABLED=false
DOCUMENTS_MAX_BYTES=10485760
DOCUMENTS_MAX_PAGES=50
DOCUMENTS_MAX_TEXT_CHARS=100000
DOCUMENTS_TIMEOUT_MS=20000

# Stage 4B — optional local OCR fallback for scanned PDFs.
DOCUMENTS_OCR_ENABLED=false
DOCUMENTS_OCR_MAX_PAGES=10
DOCUMENTS_OCR_DPI=180
DOCUMENTS_OCR_LANGUAGES=spa+eng
DOCUMENTS_OCR_TIMEOUT_MS=60000

DOCUMENT_RETENTION_ENABLED=false
DOCUMENT_RETENTION_DAYS=90

SEMANTIC_ENABLED=false
SEMANTIC_CHUNK_MAX_CHARS=1200
SEMANTIC_CHUNK_OVERLAP_CHARS=200
SEMANTIC_MAX_CHUNKS=100
EMBEDDINGS_ENABLED=false
EMBEDDINGS_PROVIDER=openai-compatible
EMBEDDINGS_BASE_URL=
EMBEDDINGS_API_KEY=
EMBEDDINGS_MODEL=
EMBEDDINGS_DIMENSIONS=1024
EMBEDDINGS_TIMEOUT_MS=20000
EMBEDDINGS_BATCH_SIZE=32

DOCUMENT_QA_ENABLED=false
DOCUMENT_QA_MAX_QUESTION_CHARS=2000
DOCUMENT_QA_MAX_CONTEXT_CHARS=7000
DOCUMENT_QA_MAX_SOURCES=5
DOCUMENT_QA_MAX_REPLY_CHARS=3500

# Google Calendar writes.
CALENDAR_ENABLED=false
CALENDAR_PROVIDER=google
GOOGLE_CALENDAR_ID=primary
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REFRESH_TOKEN=
CALENDAR_TIMEOUT_MS=20000

# Stage 5A — independent Calendar reads.
CALENDAR_READ_ENABLED=false
CALENDAR_READ_DAY_START=08:00
CALENDAR_READ_DAY_END=20:00
CALENDAR_READ_MIN_FREE_MINUTES=30
CALENDAR_READ_MAX_EVENTS=20
CALENDAR_READ_MAX_REPLY_CHARS=3500
CALENDAR_SLOT_SUGGESTIONS_ENABLED=false
CALENDAR_SLOT_MAX_SUGGESTIONS=3
CALENDAR_SLOT_ALIGNMENT_MINUTES=15
CALENDAR_SLOT_MAX_REPLY_CHARS=2000
CALENDAR_EXACT_AVAILABILITY_ENABLED=false

# Stage 7A — Gmail metadata-only read.
GMAIL_READ_ENABLED=false
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_TIMEOUT_MS=20000
GMAIL_READ_MAX_MESSAGES=5
GMAIL_READ_MAX_REPLY_CHARS=3500

# Stage 7B — explicit body read.
GMAIL_BODY_READ_ENABLED=false
GMAIL_BODY_CLIENT_ID=
GMAIL_BODY_CLIENT_SECRET=
GMAIL_BODY_REFRESH_TOKEN=
GMAIL_BODY_TIMEOUT_MS=20000
GMAIL_BODY_MAX_REPLY_CHARS=3500
GMAIL_BODY_MAX_RESPONSE_BYTES=524288
GMAIL_BODY_SELECTION_TTL_MINUTES=15

# Stage 7C — structured Gmail search.
GMAIL_SEARCH_ENABLED=false
GMAIL_SEARCH_CLIENT_ID=
GMAIL_SEARCH_CLIENT_SECRET=
GMAIL_SEARCH_REFRESH_TOKEN=
GMAIL_SEARCH_TIMEOUT_MS=20000
GMAIL_SEARCH_MAX_MESSAGES=5
GMAIL_SEARCH_MAX_REPLY_CHARS=3500
GMAIL_SEARCH_MAX_TERM_CHARS=200
GMAIL_SEARCH_MAX_DATE_RANGE_DAYS=366

# Stage 7D — explicit Gmail analysis.
GMAIL_ANALYSIS_ENABLED=false
GMAIL_ANALYSIS_MAX_MESSAGES=5
GMAIL_ANALYSIS_MAX_INPUT_CHARS=8000
GMAIL_ANALYSIS_MAX_REPLY_CHARS=2500

# Stage 8A — explicit deterministic executive snapshot.
EXECUTIVE_SUMMARY_ENABLED=false
EXECUTIVE_SUMMARY_MAX_GMAIL_MESSAGES=3
EXECUTIVE_SUMMARY_MAX_CALENDAR_EVENTS=5
EXECUTIVE_SUMMARY_MAX_LOCAL_ITEMS=3
EXECUTIVE_SUMMARY_MAX_REPLY_CHARS=3500

# Stage 8B — explicit deterministic priorities for today.
EXECUTIVE_PRIORITIES_ENABLED=false
EXECUTIVE_PRIORITIES_MAX_ACTION_ITEMS=5
EXECUTIVE_PRIORITIES_MAX_GMAIL_MESSAGES=3
EXECUTIVE_PRIORITIES_MAX_REPLY_CHARS=2500

# Stage 8C — explicit deterministic executive briefing. Disabled by default.
# Commands: `qué tengo hoy`, `dame mi briefing`, `briefing ejecutivo`.
# Combines bounded local overdue/today work with remaining Calendar agenda and unread
# Gmail metadata only when those independent read capabilities are already enabled.
# No AI, Gmail bodies/search, writes/actions or polling. Unread never means urgent.
# The combined reply is always ephemeral.
EXECUTIVE_BRIEFING_ENABLED=false
EXECUTIVE_BRIEFING_MAX_ACTION_ITEMS=5
EXECUTIVE_BRIEFING_MAX_CALENDAR_EVENTS=5
EXECUTIVE_BRIEFING_MAX_GMAIL_MESSAGES=3
EXECUTIVE_BRIEFING_MAX_REPLY_CHARS=3500

BRIEFING_ENABLED=false
BRIEFING_TIME=08:00
BRIEFING_DESTINATION_JID=

COMMITMENT_NOTIFICATIONS_ENABLED=false
COMMITMENT_NOTIFICATION_DESTINATION_JID=

OBSERVER_ENABLED=false

RETENTION_ENABLED=false
MESSAGE_RETENTION_DAYS=30
OUTBOUND_RETENTION_DAYS=30
AUDIT_RETENTION_DAYS=90
BRIEFING_RETENTION_DAYS=90
