# Runtime
NODE_ENV=development
APP_DB_PATH=./data/assistant.db
HEALTH_HOST=0.0.0.0
HEALTH_PORT=8787
APP_TIMEZONE=America/Lima

# WhatsApp pairing / self-chat
WHATSAPP_PHONE_NUMBER=
WHATSAPP_SELF_JIDS=
WHATSAPP_ENABLED=false
LOG_MESSAGE_CONTENT=false

# Stage 2A — optional AI. Disabled by default.
AI_ENABLED=false
AI_PROVIDER=openai-compatible
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT_MS=20000
AI_MAX_INPUT_CHARS=4000
AI_MAX_REPLY_CHARS=3500
AI_MAX_OUTPUT_TOKENS=800

# Stage 2B — optional audio transcription. Disabled by default.
TRANSCRIPTION_ENABLED=false
TRANSCRIPTION_PROVIDER=openai-compatible
TRANSCRIPTION_BASE_URL=
TRANSCRIPTION_API_KEY=
TRANSCRIPTION_MODEL=
TRANSCRIPTION_TIMEOUT_MS=60000
TRANSCRIPTION_MAX_BYTES=15728640
TRANSCRIPTION_MAX_CHARS=6000

# Stage 4A — local PDF text extraction/indexing. Disabled by default.
# Requires local `pdfinfo` + `pdftotext` (Docker image installs poppler-utils).
# Raw PDF bytes are temporary only; SQLite stores extracted text + minimal metadata.
DOCUMENTS_ENABLED=false
DOCUMENTS_MAX_BYTES=10485760
DOCUMENTS_MAX_PAGES=50
DOCUMENTS_MAX_TEXT_CHARS=100000
DOCUMENTS_TIMEOUT_MS=20000

# Stage 4B — optional local OCR fallback for scanned PDFs. Disabled by default.
# Requires DOCUMENTS_ENABLED=true. Docker installs Tesseract with spa+eng traineddata.
DOCUMENTS_OCR_ENABLED=false
DOCUMENTS_OCR_MAX_PAGES=10
DOCUMENTS_OCR_DPI=180
DOCUMENTS_OCR_LANGUAGES=spa+eng
DOCUMENTS_OCR_TIMEOUT_MS=60000

# Stage 4C — document lifecycle/retention. Automatic retention is disabled by default.
# Retention age is measured from local indexing time, not the WhatsApp message timestamp.
DOCUMENT_RETENTION_ENABLED=false
DOCUMENT_RETENTION_DAYS=90

# Google Calendar writes. Disabled by default.
# Requires approval + explicit `ejecuta acción #N`.
CALENDAR_ENABLED=false
CALENDAR_PROVIDER=google
GOOGLE_CALENDAR_ID=primary
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REFRESH_TOKEN=
CALENDAR_TIMEOUT_MS=20000

# Optional daily local briefing. Disabled by default.
# Destination must also appear exactly in WHATSAPP_SELF_JIDS.
BRIEFING_ENABLED=false
BRIEFING_TIME=08:00
BRIEFING_DESTINATION_JID=

# Read-only Observer. Disabled by default.
# When enabled, it still persists only text from chats explicitly allowlisted in SQLite
# through the self-chat admin commands. It cannot reply or execute capabilities.
# Requires WHATSAPP_ENABLED=true and at least one WHATSAPP_SELF_JIDS entry.
OBSERVER_ENABLED=false

# Optional operational-data retention. Disabled by default.
# These windows affect normalized self-chat messages, outbound IDs, audit and briefing-delivery rows only.
# Observer observations use their own per-chat retention policy even if this feature is disabled.
# Notes, expenses, reminders, action requests, allowlists and credentials are not purged by this job.
RETENTION_ENABLED=false
MESSAGE_RETENTION_DAYS=30
OUTBOUND_RETENTION_DAYS=30
AUDIT_RETENTION_DAYS=90
BRIEFING_RETENTION_DAYS=90
