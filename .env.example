# Runtime
NODE_ENV=development
APP_DB_PATH=./data/assistant.db
HEALTH_HOST=0.0.0.0
HEALTH_PORT=8787
APP_TIMEZONE=America/Lima

# WhatsApp pairing. Digits only, E.164 without +, e.g. 519XXXXXXXX.
WHATSAPP_PHONE_NUMBER=

# Explicit self-chat allowlist. Keep PN and a validated LID variant if applicable.
WHATSAPP_SELF_JIDS=

# Start WhatsApp transport. Set false for local core/database work.
WHATSAPP_ENABLED=false

# Do not log message bodies. Keep false unless debugging locally.
LOG_MESSAGE_CONTENT=false

# Stage 2A — optional AI. Disabled by default.
# Only messages explicitly prefixed with `ia ` or `ai ` are sent to this provider.
AI_ENABLED=false
AI_PROVIDER=openai-compatible
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT_MS=20000
AI_MAX_INPUT_CHARS=4000
AI_MAX_REPLY_CHARS=3500
AI_MAX_OUTPUT_TOKENS=800

# Stage 2B — optional audio transcription. Disabled by default.
# Only authorized self-chat audio can reach this provider.
TRANSCRIPTION_ENABLED=false
TRANSCRIPTION_PROVIDER=openai-compatible
TRANSCRIPTION_BASE_URL=
TRANSCRIPTION_API_KEY=
TRANSCRIPTION_MODEL=
TRANSCRIPTION_TIMEOUT_MS=60000
TRANSCRIPTION_MAX_BYTES=15728640
TRANSCRIPTION_MAX_CHARS=6000
