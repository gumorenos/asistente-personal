# Runtime
NODE_ENV=development
APP_DB_PATH=./data/assistant.db
HEALTH_HOST=0.0.0.0
HEALTH_PORT=8787
APP_TIMEZONE=America/Lima

# WhatsApp pairing / self-chat
WHATSAPP_PHONE_NUMBER=
WHATSAPP_SELF_JIDS=
WHATSAPP_ENABLED=false
LOG_MESSAGE_CONTENT=false

# Stage 2A — optional AI. Disabled by default.
AI_ENABLED=false
AI_PROVIDER=openai-compatible
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT_MS=20000
AI_MAX_INPUT_CHARS=4000
AI_MAX_REPLY_CHARS=3500
AI_MAX_OUTPUT_TOKENS=800

# Stage 2B — optional audio transcription. Disabled by default.
TRANSCRIPTION_ENABLED=false
TRANSCRIPTION_PROVIDER=openai-compatible
TRANSCRIPTION_BASE_URL=
TRANSCRIPTION_API_KEY=
TRANSCRIPTION_MODEL=
TRANSCRIPTION_TIMEOUT_MS=60000
TRANSCRIPTION_MAX_BYTES=15728640
TRANSCRIPTION_MAX_CHARS=6000

# Stage 4A — local PDF text extraction/indexing. Disabled by default.
# Requires local `pdfinfo` + `pdftotext` (Docker image installs poppler-utils).
# Raw PDF bytes are temporary only; SQLite stores extracted text + minimal metadata.
DOCUMENTS_ENABLED=false
DOCUMENTS_MAX_BYTES=10485760
DOCUMENTS_MAX_PAGES=50
DOCUMENTS_MAX_TEXT_CHARS=100000
DOCUMENTS_TIMEOUT_MS=20000

# Stage 4B — optional local OCR fallback for scanned PDFs. Disabled by default.
# Requires DOCUMENTS_ENABLED=true. Docker installs Tesseract with spa+eng traineddata.
DOCUMENTS_OCR_ENABLED=false
DOCUMENTS_OCR_MAX_PAGES=10
DOCUMENTS_OCR_DPI=180
DOCUMENTS_OCR_LANGUAGES=spa+eng
DOCUMENTS_OCR_TIMEOUT_MS=60000

# Stage 4C — document lifecycle/retention. Automatic retention is disabled by default.
# Retention age is measured from local indexing time, not the WhatsApp message timestamp.
DOCUMENT_RETENTION_ENABLED=false
DOCUMENT_RETENTION_DAYS=90

# Stage 4D — semantic document memory. Both layers are disabled by default.
# SEMANTIC_ENABLED creates local document chunks only. No external traffic.
SEMANTIC_ENABLED=false
SEMANTIC_CHUNK_MAX_CHARS=1200
SEMANTIC_CHUNK_OVERLAP_CHARS=200
SEMANTIC_MAX_CHUNKS=100
# EMBEDDINGS_ENABLED is a second, explicit privacy opt-in. When true, document chunks
# and explicit semantic search queries are sent to the configured embedding endpoint.
EMBEDDINGS_ENABLED=false
EMBEDDINGS_PROVIDER=openai-compatible
EMBEDDINGS_BASE_URL=
EMBEDDINGS_API_KEY=
EMBEDDINGS_MODEL=
EMBEDDINGS_DIMENSIONS=1024
EMBEDDINGS_TIMEOUT_MS=20000
EMBEDDINGS_BATCH_SIZE=32

# Stage 4E — explicit document Q&A. Disabled by default.
# This is a third privacy opt-in and requires AI + semantic + embeddings enabled.
# Only the explicit question plus a bounded set of retrieved document excerpts are sent to AI.
DOCUMENT_QA_ENABLED=false
DOCUMENT_QA_MAX_QUESTION_CHARS=2000
DOCUMENT_QA_MAX_CONTEXT_CHARS=7000
DOCUMENT_QA_MAX_SOURCES=5
DOCUMENT_QA_MAX_REPLY_CHARS=3500

# Google Calendar writes. Disabled by default.
# Requires approval + explicit `ejecuta acción #N`.
CALENDAR_ENABLED=false
CALENDAR_PROVIDER=google
GOOGLE_CALENDAR_ID=primary
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REFRESH_TOKEN=
CALENDAR_TIMEOUT_MS=20000

# Stage 5A — Google Calendar read-only. Independent from write enablement.
# Keep CALENDAR_ENABLED=false if only reads are wanted. Mint the refresh token with
# minimum scopes: calendar.events.readonly + calendar.freebusy.
# Commands: `agenda hoy`, `agenda mañana`, `agenda semana`,
# `disponibilidad hoy`, `disponibilidad mañana`.
CALENDAR_READ_ENABLED=false
CALENDAR_READ_DAY_START=08:00
CALENDAR_READ_DAY_END=20:00
CALENDAR_READ_MIN_FREE_MINUTES=30
CALENDAR_READ_MAX_EVENTS=20
CALENDAR_READ_MAX_REPLY_CHARS=3500

# Stage 5B — deterministic slot suggestions. Disabled by default and requires
# CALENDAR_READ_ENABLED=true. It never creates an action or Calendar event.
# Example: `propón horarios mañana para 30 minutos`.
CALENDAR_SLOT_SUGGESTIONS_ENABLED=false
CALENDAR_SLOT_MAX_SUGGESTIONS=3
CALENDAR_SLOT_ALIGNMENT_MINUTES=15
CALENDAR_SLOT_MAX_REPLY_CHARS=2000

# Stage 5C — exact read-only availability check. Disabled by default and requires
# CALENDAR_READ_ENABLED=true. It queries only the requested interval, does not use AI,
# creates no action and performs no Calendar write.
# Example: `libre mañana a las 10 por 30 minutos`.
CALENDAR_EXACT_AVAILABILITY_ENABLED=false

# Stage 7A — Gmail metadata-only read. Independent from Calendar credentials/flags.
# Disabled by default. Mint this dedicated refresh token with the narrow Gmail scope:
# https://www.googleapis.com/auth/gmail.metadata
# Stage 7A requests INBOX/UNREAD labels plus From/Subject headers only; it does not
# request email bodies, attachments, raw/full format, free-text Gmail search or mutations.
# Commands: `correos`, `correos recientes [N]`, `correos no leídos [N]`.
GMAIL_READ_ENABLED=false
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_TIMEOUT_MS=20000
GMAIL_READ_MAX_MESSAGES=5
GMAIL_READ_MAX_REPLY_CHARS=3500

# Stage 7B — explicit body read for one message selected from the latest Stage 7A list.
# Separate privacy opt-in and separate refresh token. Intended scope:
# https://www.googleapis.com/auth/gmail.readonly
# Requires GMAIL_READ_ENABLED=true. No persistence, AI, attachments or mailbox writes.
# Command: `correo #N`. Selection ids live only in process memory and expire by TTL.
GMAIL_BODY_READ_ENABLED=false
GMAIL_BODY_CLIENT_ID=
GMAIL_BODY_CLIENT_SECRET=
GMAIL_BODY_REFRESH_TOKEN=
GMAIL_BODY_TIMEOUT_MS=20000
GMAIL_BODY_MAX_REPLY_CHARS=3500
GMAIL_BODY_MAX_RESPONSE_BYTES=524288
GMAIL_BODY_SELECTION_TTL_MINUTES=15

# Optional daily local briefing. Disabled by default.
# Destination must also appear exactly in WHATSAPP_SELF_JIDS.
BRIEFING_ENABLED=false
BRIEFING_TIME=08:00
BRIEFING_DESTINATION_JID=

# Stage 6B — optional due commitment notifications. Disabled by default.
# Destination must be an exact self-chat JID already present in WHATSAPP_SELF_JIDS.
# Sends only after a commitment is due; no AI/Calendar/Observer processing is involved.
COMMITMENT_NOTIFICATIONS_ENABLED=false
COMMITMENT_NOTIFICATION_DESTINATION_JID=

# Read-only Observer. Disabled by default.
# When enabled, it still persists only text from chats explicitly allowlisted in SQLite
# through the self-chat admin commands. It cannot reply or execute capabilities.
# Requires WHATSAPP_ENABLED=true and at least one WHATSAPP_SELF_JIDS entry.
OBSERVER_ENABLED=false

# Optional operational-data retention. Disabled by default.
# These windows affect normalized self-chat messages, outbound IDs, audit and briefing-delivery rows only.
# Observer observations use their own per-chat retention policy even if this feature is disabled.
# Notes, expenses, reminders, action requests, allowlists and credentials are not purged by this job.
RETENTION_ENABLED=false
MESSAGE_RETENTION_DAYS=30
OUTBOUND_RETENTION_DAYS=30
AUDIT_RETENTION_DAYS=90
BRIEFING_RETENTION_DAYS=90
