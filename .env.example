# Runtime
NODE_ENV=development
APP_DB_PATH=./data/assistant.db
HEALTH_HOST=0.0.0.0
HEALTH_PORT=8787

# WhatsApp pairing. Digits only, E.164 without +, e.g. 519XXXXXXXX.
WHATSAPP_PHONE_NUMBER=

# REQUIRED before automatic replies are enabled.
# Comma-separated self-chat JIDs accepted as own chat identities.
# Keep both PN and LID variants if WhatsApp exposes both.
# Example: 519XXXXXXXX@s.whatsapp.net,123456789012345@lid
WHATSAPP_SELF_JIDS=

# Start WhatsApp transport. Set false for local core/database work.
WHATSAPP_ENABLED=false

# Do not log message bodies. Keep false unless debugging locally.
LOG_MESSAGE_CONTENT=false
